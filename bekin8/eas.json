{
  "cli": { "version": ">= 16.20.4", "appVersionSource": "local" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "image": "sdk-55" }
    },
    "preview": {
      "distribution": "internal",
      "ios": { "image": "sdk-55" }
    },
    "production": {
      "ios": { "image": "sdk-55", "autoIncrement": "version" },
      "android": { "autoIncrement": "versionCode" }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "alpha",
        "releaseStatus": "completed"
      }
    }
  }
}
