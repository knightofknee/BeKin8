rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // NOTE: this file is the source of truth for Firestore rules, deployed via
    // `firebase deploy --only firestore:rules`. Project: waldgrave-profiles. (Escape from Hades IRL
    // is a SEPARATE Firebase project and is not governed by this file, despite the vacationDays
    // block below, which is inert leftover.)
    //
    // Firestore ORs every matching block: if any one of them allows an operation, it is allowed.
    // That makes the catch-all at the bottom the most dangerous block in the file. Both of its
    // blanket grants have now been closed, `read` in 2026-07-07 and `create` after that grant was
    // found to be quietly defeating every per-collection create guard above.
    //
    // Shared content (Posts, Profiles, Beacons, ChatMessages, comments, Favorites) requires sign-in
    // to read, but is NOT audience-scoped at the rules layer: any signed-in user can read any post.
    // The friends-only / friends-of-friends feed is a CLIENT query convention. It cannot currently
    // be enforced here, because a query is only permitted when its own filters prove the read rule,
    // and "the author is my friend" is not provable from `where('author','in',[...])` without a
    // cross-collection join. Enforcing audience server-side would mean denormalizing a reader list
    // onto every post and querying it with array-contains.

    // -------- users subtree --------
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /friends/{friendId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /friendSubscriptions/{friendUid} {
        allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
      }
      match /blocks/{blockedUid} {
        // The blockee may READ the single doc that would block THEM (path-keyed, so it also works
        // for a non-existent doc = "not blocked"), which the client uses to pre-check before sending
        // a friend request. Only the owner may see the full list or mutate it.
        allow read: if request.auth != null
                    && (request.auth.uid == userId || request.auth.uid == blockedUid);
        allow create, update, delete: if request.auth != null && request.auth.uid == userId;
      }
      match /pushTokens/{docId} {
        allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
      }
      // Per-post mutes for comment notifications. This needs its OWN match block: `match /users/{userId}`
      // covers the user document ONLY, never its subcollections. Without this, the feed's
      // silencedPosts collection listener fell through to the catch-all and was denied, which
      // silently broke muting (the listener has no error callback, so the muted set just stayed
      // empty). Path-keyed, so the collection listener is provable against it.
      match /silencedPosts/{postId} {
        allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // -------- Favorites --------
    match /Favorites/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // -------- Friends doc (array) --------
    match /Friends/{userId} {
      allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // -------- FriendEdges --------
    match /FriendEdges/{edgeId} {
      function authed()      { return request.auth != null; }
      // The uid in `uids` that is not the caller.
      function otherOf(uids) { return uids[0] == request.auth.uid ? uids[1] : uids[0]; }
      // Consent gate. FriendRequests doc ids are `{senderUid}_{receiverUid}`, so this path only
      // resolves when the OTHER party sent a request to ME and I have already accepted it, which
      // is exactly who is entitled to turn a request into a friendship. The sender cannot use it
      // to self-approve: for them the path would be `{me}_{other}`, which does not exist.
      // A get() is fine here: this is a single-document create (10-document-access limit), and
      // query-provability does not apply because nothing ever queries a create rule.
      function acceptedRequestFrom(otherUid) {
        return exists(/databases/$(database)/documents/FriendRequests/$(otherUid + '_' + request.auth.uid))
               && get(/databases/$(database)/documents/FriendRequests/$(otherUid + '_' + request.auth.uid)).data.status == 'accepted';
      }

      // Query-compatible: a `where('uids','array-contains', uid)` query is provable against this,
      // which the older size()==2/is-list form was NOT (it only worked because the removed catch-all
      // granted read to everything). Reads are still restricted to edge participants.
      allow read: if authed() && request.auth.uid in resource.data.uids;
      // Force-friending fix: the shape checks alone let ANY signed-in user write
      // {uids:[me, victim], state:'accepted'} and become a stranger's friend, since nothing tied
      // the edge to consent and `state` was never checked. Profiles are keyed by uid and readable
      // to any signed-in user, so the victim set was the entire user base. Admin-SDK writers
      // (addFriendMutual, redeemInvite, which establish consent their own way) bypass rules and are
      // unaffected. The client's only edge write is the accept handler in app/friends.tsx, which
      // updates the request to `accepted` before writing the edge, so it satisfies this.
      allow create: if authed()
                    && request.resource.data.uids is list
                    && request.resource.data.uids.size() == 2
                    && request.resource.data.uids.hasAny([request.auth.uid])
                    && request.resource.data.uids[0] != request.resource.data.uids[1]
                    && acceptedRequestFrom(otherOf(request.resource.data.uids));
      allow delete: if authed() && request.auth.uid in resource.data.uids;
      allow update: if false;
    }

    // -------- FriendRequests --------
    match /FriendRequests/{requestId} {
      function authed()        { return request.auth != null; }
      function sender(d)       { return authed() && d.senderUid == request.auth.uid; }
      function receiver(d)     { return authed() && d.receiverUid == request.auth.uid; }
      function isParticipant(d){ return authed() && (sender(d) || receiver(d)); }

      allow create: if authed()
                    && request.resource.data.senderUid == request.auth.uid
                    && request.resource.data.status == "pending";
      // Query-compatible (a where('receiverUid'|'senderUid','==', me) listener is provable against
      // this). A get-by-id existence check on a NON-existent request is denied by these rules, so the
      // client wraps those gets and treats a denial as "no request". Restricted to participants.
      allow read: if authed()
                  && (resource.data.senderUid == request.auth.uid
                      || resource.data.receiverUid == request.auth.uid);
      allow update: if authed() && (
        (receiver(resource.data) && resource.data.status == "pending" &&
          (request.resource.data.status == "accepted" || request.resource.data.status == "rejected"))
        ||
        (sender(resource.data) && resource.data.status == "pending" &&
          request.resource.data.status == "cancelled")
      );
      allow delete: if isParticipant(resource.data) && resource.data.status != "pending";
    }

    // -------- Beacons + ChatMessages --------
    match /Beacons/{beaconId} {
      function authed()     { return request.auth != null; }
      function isOwner()    { return authed() && resource.data.ownerUid == request.auth.uid; }
      function isAllowed()  {
        return authed()
               && resource.data.allowedUids is list
               && resource.data.allowedUids.hasAny([request.auth.uid]);
      }
      function currentInUids() {
        return (resource.data.inUids is list) ? resource.data.inUids : [];
      }

      allow read: if authed();
      allow create: if authed()
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update: if authed() && (
        isOwner() ||
        (
          isAllowed() &&
          request.resource.data.diff(resource.data).changedKeys().hasOnly(['inUids','updatedAt']) &&
          request.resource.data.inUids is list &&
          request.resource.data.inUids.hasAll(currentInUids()) &&
          request.resource.data.inUids.size() >= currentInUids().size()
        )
      );
      allow delete: if isOwner();

      match /ChatMessages/{msgId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow delete: if request.auth != null && resource.data.authorUid == request.auth.uid;
        // Reactions only: any signed-in user may change the `reactions` map and nothing else.
        // The hasOnly clause blocks editing an existing message's text/media/author.
        allow update: if request.auth != null
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);
      }
    }

    // -------- Profiles + lists subcollection --------
    match /Profiles/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;

      match /lists/{listId} {
        allow read: if request.auth != null;
        allow create, update, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // -------- FriendGroups --------
    match /FriendGroups/{groupId} {
      function authed()     { return request.auth != null; }
      function isOwner()    { return authed() && resource.data.ownerUid == request.auth.uid; }
      function ownerStable(){ return authed() && request.resource.data.ownerUid == request.auth.uid; }

      // Query-compatible (a where('ownerUid','==', me) listener is provable via the owner branch).
      // A member may read a group they belong to (the beacon list resolves a friend's group this
      // way; it cannot enumerate groups it is not in). A get-by-id on a NON-existent group is denied,
      // so the client (ensureTestGroup) wraps that get and treats a denial as "does not exist".
      allow read: if authed()
                  && (resource.data.ownerUid == request.auth.uid
                      || request.auth.uid in resource.data.memberUids);
      allow create: if ownerStable()
                    && request.resource.data.name is string
                    && request.resource.data.memberUids is list;
      allow update: if isOwner()
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && request.resource.data.diff(resource.data).changedKeys()
                         .hasOnly(['name','memberUids','updatedAt']);
      allow delete: if isOwner();
    }

    // -------- Posts (top-level) + comments --------
    match /Posts/{postId} {
      function authed()   { return request.auth != null; }
      function isAuthor() { return authed() && resource.data.author == request.auth.uid; }

      allow read: if authed();
      // Pinning `author` to the caller is what makes attribution trustworthy. This was previously
      // unenforceable no matter what was written here: the catch-all's blanket
      // `allow create: if request.auth != null` ORed with this block and granted the write anyway,
      // so any signed-in user could publish a post attributed to anyone. The catch-all is now closed.
      allow create: if authed() && request.resource.data.author == request.auth.uid;
      // Posts had NO update/delete rule of their own and leaned on the catch-all's author guard.
      // With the catch-all closed they need explicit ones. `author` is pinned on update so an edit
      // cannot reassign a post to somebody else.
      allow update: if isAuthor() && request.resource.data.author == resource.data.author;
      allow delete: if isAuthor();

      match /comments/{commentId} {
        // Named commentAuthor, not isAuthor: the enclosing Posts block already defines isAuthor
        // against `author`, and comments key off `authorUid`.
        function commentAuthor() { return authed() && resource.data.authorUid == request.auth.uid; }
        function createsAsSelf() {
          return authed() && request.resource.data.authorUid == request.auth.uid;
        }
        allow read: if authed();
        allow create: if createsAsSelf();
        allow update: if commentAuthor();
        allow delete: if commentAuthor();
      }
    }

    // -------- Reports (UGC moderation) --------
    match /Reports/{reportId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // -------- Invites (code -> uid map) --------
    // Locked: only the Admin SDK (redeem / ensureInviteCode) touches it, and the Admin SDK bypasses
    // rules. Clients must never read it, or the code->uid map could be enumerated and used to
    // force-friend arbitrary users.
    match /Invites/{code} {
      allow read, write: if false;
    }

    // -------- Usernames (uniqueness reservations) --------
    // Never read by clients. The first writer creates the doc; a second racing claimer's write is an
    // UPDATE, which no rule allows, so uniqueness holds. Owners may delete their own reservation to
    // release a name on rename.
    match /Usernames/{name} {
      allow read: if false;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // -------- ClientErrors (crash / error logs) --------
    // Write-only for authed clients; readable only in the console / via the Admin SDK.
    match /ClientErrors/{docId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // -------- PushTokens --------
    match /PushTokens/{uid} {
      allow read, create, update, delete: if request.auth != null && request.auth.uid == uid;
    }

    // -------- Vacation Days (habit-tracking breaks) --------
    // Doc id: `${userId}_${date}`. Each doc stores userId for queries.
    match /vacationDays/{docId} {
      function authed()    { return request.auth != null; }
      function isOwner()   { return authed() && resource.data.userId == request.auth.uid; }
      function ownsNew()   { return authed() && request.resource.data.userId == request.auth.uid; }

      allow read: if isOwner();
      allow create: if ownsNew();
      allow update: if isOwner()
                    && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner();
    }

    // -------- Catch-all --------
    // FULLY CLOSED, and it must stay that way. Because Firestore ORs matching blocks, anything
    // permissive here silently overrides every restriction above. The blanket `allow read: if true`
    // was closed 2026-07-07. The blanket `allow create: if request.auth != null` survived that pass
    // and had exactly the same defeating effect on writes, which left every create guard in this
    // file decorative: any signed-in user could forge FriendEdges between strangers, create a
    // Profile or Username reservation under someone else's uid, forge a FriendRequest from any
    // sender, own a Beacon they did not create, plant an Invites code, or post as anyone.
    // update/delete were author-guarded but only ever reached Posts (the sole collection with an
    // `author` field and no rule of its own), which now has explicit rules.
    //
    // Every collection the client touches has its own block above. Do NOT reintroduce a permissive
    // rule here to make a new collection work: add an explicit match block for it instead.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
